#include <winver.h>
#include <capusy_version.h>
#include "resource.h"

IDI_APP_ICON ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     CAPUSY_VERSION_MAJOR,CAPUSY_VERSION_MINOR,CAPUSY_VERSION_PATCH,CAPUSY_VERSION_TWEAK
PRODUCTVERSION  CAPUSY_VERSION_MAJOR,CAPUSY_VERSION_MINOR,CAPUSY_VERSION_PATCH,CAPUSY_VERSION_TWEAK
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "usy"
            VALUE "FileDescription",  "capusy"
            VALUE "FileVersion",      CAPUSY_VERSION_STR
            VALUE "InternalName",     "capusy"
            VALUE "OriginalFilename", "capusy.exe"
            VALUE "ProductName",      "capusy"
            VALUE "ProductVersion",   CAPUSY_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
